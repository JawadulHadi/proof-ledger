# Files `vercel deploy` from a local checkout should not upload (Git deploys already skip
# whatever .gitignore covers). staticfiles/ is rebuilt by vercel-build.sh, so a stale local
# copy must not be uploaded.
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
db.sqlite3
staticfiles/
.vscode/
