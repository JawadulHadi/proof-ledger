# Required when DEBUG=0. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Hosted Postgres (Neon). Unset = SQLite locally, or POSTGRES_* for docker compose.
DATABASE_URL=
GITHUB_USER=JawadulHadi
# Optional: raises the GitHub API rate limit for sync_github. Never commit a real token.
GITHUB_TOKEN=
# Optional: creates the admin user on first boot (start.sh).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
